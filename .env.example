# GlowWheels Mobile Car Wash Environment Configuration

# Flask Secret Key
SECRET_KEY=glowwheels-secret-key-change-in-production

# Fixed Admin Credentials (per project requirement)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Admin Phone Number for WhatsApp Alerts (Include country code without + e.g. 919876543210)
ADMIN_PHONE=919876543210

# Database URL:
# Local SQLite is default: sqlite:///glowwheels.db
# For Production Vercel / Render with PostgreSQL (e.g. Supabase / Neon):
# DATABASE_URL=postgresql://postgres:password@host:5432/dbname

# Server Port
PORT=5000

